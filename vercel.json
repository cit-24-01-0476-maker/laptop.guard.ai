{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/(.*\\.exe)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"LaptopGuard-Setup.exe\""
        }
      ]
    },
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"LaptopGuard-AI.apk\""
        }
      ]
    },
    {
      "source": "/(.*\\.zip)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"LaptopGuard-Windows-Agent-v1.5.2.zip\""
        }
      ]
    },
    {
      "source": "/(index.html|version.json|manifest.json|favicon.svg|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/windows-setup",
      "destination": "/LaptopGuard-Setup.exe"
    },
    {
      "source": "/downloads/windows-exe",
      "destination": "/LaptopGuard-Setup.exe"
    },
    {
      "source": "/downloads/android-apk",
      "destination": "/LaptopGuard-AI.apk"
    },
    {
      "source": "/downloads/windows-agent",
      "destination": "/LaptopGuard-Windows-Agent-v1.5.2.zip"
    },
    {
      "source": "/downloads/windows-zip",
      "destination": "/LaptopGuard-Windows-Agent-v1.5.2.zip"
    },
    {
      "source": "/api/v1/downloads/:match*",
      "destination": "https://laptopguard-api.onrender.com/api/v1/downloads/:match*"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
