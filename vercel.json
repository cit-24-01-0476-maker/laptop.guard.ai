{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/(index.html|version.json|manifest.json|favicon.svg|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/LaptopGuard-Setup.exe",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-setup"
    },
    {
      "source": "/LaptopGuard-AI.apk",
      "destination": "https://laptopguard-api.onrender.com/downloads/android-apk"
    },
    {
      "source": "/downloads/windows-setup",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-setup"
    },
    {
      "source": "/downloads/windows-exe",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-setup"
    },
    {
      "source": "/downloads/android-apk",
      "destination": "https://laptopguard-api.onrender.com/downloads/android-apk"
    },
    {
      "source": "/downloads/windows-agent",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-setup"
    },
    {
      "source": "/downloads/windows-zip",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-setup"
    },
    {
      "source": "/api/v1/downloads/:match*",
      "destination": "https://laptopguard-api.onrender.com/api/v1/downloads/:match*"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
