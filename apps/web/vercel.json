{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"LaptopGuard-AI.apk\""
        }
      ]
    },
    {
      "source": "/(index.html|version.json|manifest.json|favicon.svg|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/android-apk",
      "destination": "/LaptopGuard-AI.apk"
    },
    {
      "source": "/downloads/windows-setup",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-setup"
    },
    {
      "source": "/downloads/windows-exe",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-exe"
    },
    {
      "source": "/downloads/windows-agent",
      "destination": "https://laptopguard-api.onrender.com/downloads/windows-agent"
    },
    {
      "source": "/api/v1/downloads/:match*",
      "destination": "https://laptopguard-api.onrender.com/api/v1/downloads/:match*"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
