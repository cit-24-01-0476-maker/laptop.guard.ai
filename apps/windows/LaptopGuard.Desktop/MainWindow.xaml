<Window x:Class="LaptopGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LaptopGuard.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LaptopGuard AI — Production Hardware Sentinel" 
        Height="660" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Border Background="#090D16" 
            BorderBrush="#1E293B" 
            BorderThickness="1.5" 
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#0284C7" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/> <!-- Window Header -->
                <RowDefinition Height="*"/>  <!-- Main Content -->
                <RowDefinition Height="36"/> <!-- Status Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Window Header (Draggable) -->
            <Border Grid.Row="0" 
                    Background="#0F172A" 
                    CornerRadius="16,16,0,0" 
                    BorderBrush="#1E293B" 
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <!-- Title & Brand -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0284C7" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                            <TextBlock Text="🛡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="LAPTOPGUARD" Foreground="#FFFFFF" FontWeight="Black" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="AI" Foreground="#38BDF8" FontWeight="Black" FontSize="16" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AgentVersion}" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Header Right: Service Health & Window Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- IPC Status Pill -->
                        <Border Background="#1E293B" CornerRadius="12" Padding="8,4" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" 
                                         Fill="{Binding IsIpcConnected, Converter={x:Null}}" 
                                         Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIpcConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding IsIpcConnected, Converter={x:Null}}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Service Disconnected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIpcConnected}" Value="True">
                                                    <Setter Property="Text" Value="Sentinel Service Active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Minimize Button -->
                        <Button Click="Minimize_Click" Width="32" Height="32" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" Cursor="Hand" Margin="0,0,4,0">
                            <TextBlock Text="—" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Close Button (Minimizes to Tray) -->
                        <Button Click="Close_Click" Width="32" Height="32" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" Cursor="Hand">
                            <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Content Area -->
            <Grid Grid.Row="1" Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Protection Status Card -->
                    <RowDefinition Height="Auto"/> <!-- Telemetry Grid -->
                    <RowDefinition Height="Auto"/> <!-- Action Controls -->
                    <RowDefinition Height="*"/>    <!-- Incident Feed -->
                </Grid.RowDefinitions>

                <!-- 2.1 Protection Status Card -->
                <Border Grid.Row="0" 
                        Background="#0F172A" 
                        BorderBrush="{Binding StateColor}" 
                        BorderThickness="1.5" 
                        CornerRadius="14" 
                        Padding="22,18" 
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="10" Height="10" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StateTitle}" 
                                           Foreground="{Binding StateColor}" 
                                           FontWeight="Black" 
                                           FontSize="22" 
                                           />
                            </StackPanel>
                            <TextBlock Text="{Binding StateSubtitle}" 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Arm / Disarm Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding ToggleArmButtonText}" 
                                    Click="ToggleArm_Click"
                                    Height="44" 
                                    Padding="24,0" 
                                    Background="{Binding ToggleArmButtonColor}" 
                                    Foreground="#FFFFFF" 
                                    BorderThickness="0" 
                                    FontWeight="Bold" 
                                    FontSize="14" 
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Lock Now" 
                                    Click="LockNow_Click"
                                    Height="44" 
                                    Padding="18,0" 
                                    Background="#1E293B" 
                                    Foreground="#F8FAFC" 
                                    BorderBrush="#334155" 
                                    BorderThickness="1" 
                                    FontWeight="SemiBold" 
                                    FontSize="13" 
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2.2 Telemetry Grid (4 Cards) -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tile 1: Power Status -->
                    <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="POWER SOURCE" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding PowerSourceText}" Foreground="{Binding PowerSourceColor}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tile 2: Battery Level -->
                    <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="BATTERY LEVEL" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding BatteryText}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding BatteryPercentage}" Maximum="100" Height="6" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tile 3: Device Identity -->
                    <Border Grid.Column="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="DEVICE IDENTITY" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding DeviceName}" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tile 4: Hardware Engine -->
                    <Border Grid.Column="6" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SECURITY ENGINE" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Win32 Power Hook" Foreground="#10B981" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2.3 Quick Action Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="📱 Pair Mobile Phone (QR Code)" Click="PairPhone_Click" Height="36" Padding="16,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Grid.Column="1" Content="🔑 Change Master PIN" Click="ChangePin_Click" Height="36" Padding="16,0" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Grid.Column="3" Content="⟳ Refresh Feed" Click="RefreshFeed_Click" Height="36" Padding="14,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <!-- 2.4 Incident Feed -->
                <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <TextBlock Text="LOCAL INCIDENT JOURNAL (SQLITE WAL ENGINE)" Foreground="#64748B" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Durable Offline Storage Active" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding RecentIncidents}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Severity Dot -->
                                            <Border Grid.Column="0" Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Severity}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                                       Foreground="#64748B" 
                                                       FontSize="11" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Status Footer -->
            <Border Grid.Row="2" Background="#060A12" CornerRadius="0,0,16,16" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <TextBlock Text="LaptopGuard AI • Protect Your Laptop. Wherever You Go. • Production Grade" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="Protected under Win32 Hardware API" Foreground="#475569" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
