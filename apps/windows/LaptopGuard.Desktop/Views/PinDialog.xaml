<Window x:Class="LaptopGuard.Desktop.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaptopGuard Security Verification"
        Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#0F172A"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#0284C7" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="SECURITY VERIFICATION" 
                           Foreground="#38BDF8" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           />
                <TextBlock Text="Enter Master PIN" 
                           Foreground="#F8FAFC" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Margin="0,4,0,2"/>
                <TextBlock Text="Authorization required to modify security state." 
                           Foreground="#94A3B8" 
                           FontSize="12"/>
            </StackPanel>

            <!-- PIN Input -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <PasswordBox x:Name="PinBox"
                             MaxLength="8"
                             FontSize="24"
                             FontWeight="Bold"
                             HorizontalContentAlignment="Center"
                             Background="#1E293B"
                             Foreground="#38BDF8"
                             BorderBrush="#475569"
                             BorderThickness="1"
                             Padding="8"
                             KeyDown="PinBox_KeyDown"/>
                <TextBlock x:Name="ErrorText" 
                           Text="" 
                           Foreground="#EF4444" 
                           FontSize="12" 
                           FontWeight="Medium" 
                           HorizontalAlignment="Center" 
                           Margin="0,8,0,0" 
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Cancel" 
                        Click="Cancel_Click"
                        Height="40"
                        Background="#1E293B"
                        Foreground="#94A3B8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" 
                        Content="Verify PIN" 
                        Click="Verify_Click"
                        Height="40"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
